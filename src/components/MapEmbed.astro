---
import { getImage } from 'astro:assets';
import location from '../assets/location/mandala-location.png';
const widths = [240, 360, 480, 640, 960];
const generate = format => Promise.all(widths.map(width => getImage({ src: location, width, format, quality: 90 })));
const [avif, webp] = await Promise.all([generate('avif'), generate('webp')]);
const srcset = images => images.map((image, i) => `${image.src} ${widths[i]}w`).join(', ');
const sizes = '(max-width: 720px) 44vw, 250px';
---
<a href="https://www.google.com/maps?q=Mandala%20Life%20%26%20Yoga%20Sagres" target="_blank" rel="noopener noreferrer" class="location-map" data-location-map aria-label="Open Mandala Sagres in Google Maps">
  <picture style="display: contents;">
    <source type="image/avif" srcset={srcset(avif)} sizes={sizes} />
    <source type="image/webp" srcset={srcset(webp)} sizes={sizes} />
    <img src={webp[2].src} srcset={srcset(webp)} sizes={sizes} width="960" height="1280" alt="Street map showing Mandala Life &amp; Yoga Sagres near R. da Botelha" loading="lazy" decoding="async" class="location-map-image" />
  </picture>
</a>
