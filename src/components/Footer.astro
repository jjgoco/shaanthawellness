---
import pages from '../data/pages.json';
const { page, home = false } = Astro.props;
const style = home ? 'max-width: 1200px; margin: 0 auto; padding: 0 clamp(20px, 5vw, 72px) 56px; display: flex; gap: 24px; flex-wrap: wrap; justify-content: space-between; font-size: 13px; color: color-mix(in srgb, var(--color-text) 90%, transparent);' : undefined;
---
<footer style={style} data-screen-label={home ? 'Footer' : undefined}>
  <span>© 2026 shaantha wellness · ayurvedic massage &amp; recovery · sagres, portugal</span>
  <span style="display: flex; gap: 20px; flex-wrap: wrap;">{pages[page].footerLinks.map(({ label, ...attributes }) => <a {...attributes}>{label}</a>)}</span>
</footer>
