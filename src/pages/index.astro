---
import SiteLayout from '../layouts/SiteLayout.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import MapEmbed from '../components/MapEmbed.astro';
import '../styles/home.css';
---
<SiteLayout page="index" home={true}>
<main id="main-content" tabindex="-1">

<section data-screen-label="Hero" style="max-width: 1200px; margin: 0 auto; padding: clamp(48px, 8vh, 96px) clamp(20px, 5vw, 72px) clamp(40px, 6vh, 72px); display: flex; flex-wrap: wrap; gap: clamp(32px, 5vw, 48px); align-items: center;">
  <div style="flex: 999 1 420px; min-width: 0;">
    <span style="display: inline-flex; align-items: center; gap: 10px; font-size: 15px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-accent-2-800);"><span style="width: 12px; height: 12px; border-radius: 50%; background: var(--color-accent-2); display: inline-block;"></span>Algarve · Portugal</span>
    <h1 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(44px, 6.4vw, 88px); line-height: 1.06; margin: 20px 0 0; margin-left: -0.028em; text-transform: none;">Ayurvedic &amp; Sports Massage in Sagres</h1>
