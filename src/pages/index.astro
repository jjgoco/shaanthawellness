    <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; align-items: center;">
      <a class="btn btn-primary" href="https://wa.me/351938132927?text=Hi!%20I%27d%20like%20to%20book%20a%20massage%20%3A%29" target="_blank" rel="noopener noreferrer" style="color: #fff; display: inline-flex; align-items: center; gap: 10px;"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"></path></svg>Book on WhatsApp</a>
      <a class="btn btn-ghost" href="#treatments">See treatments</a>
      <span style="font-size: 16px; color: color-mix(in srgb, var(--color-text) 90%, transparent);">every day · 8:00 — 20:00</span>
    </div>
  </div>
  <div style="position: relative; flex: 1 1 280px; max-width: 400px; margin-inline: auto;">
    <div style="position: absolute; inset: -28px 28px 28px -28px; border-radius: 50%; background: var(--color-accent-2-200); z-index: 0;"></div>
    <div class="washed" style="position: relative; z-index: 1; width: 100%; aspect-ratio: 1; border-radius: 50%; overflow: hidden;">
      <ResponsiveImage name="hero" sizes="(max-width: 720px) calc(100vw - 40px), (max-width: 1200px) 40vw, 440px" alt="Warm oil massage in progress" width="667" height="1000" fetchpriority="high" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
    </div>
  </div>
</section>

<section id="treatments" data-screen-label="Treatments" style="max-width: 1200px; margin: 0 auto; padding: clamp(40px, 7vh, 80px) clamp(20px, 5vw, 72px);">
  <div style="display: flex; align-items: baseline; justify-content: space-between; gap: 24px; flex-wrap: wrap;">
    <h2 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(30px, 3.4vw, 44px); margin: 0; margin-left: -0.028em;">Treatments</h2>
    <span class="tag tag-accent">every treatment · 60 mins — 50€</span>
  </div>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-top: 36px;">
    <a class="card" href="https://wa.me/351938132927?text=Hi!%20I%27m%20interested%20in%20the%20Abhyanga%20treatment%20%3A%29" target="_blank" rel="noopener noreferrer" style="text-decoration: none; color: inherit; display: block; cursor: pointer;" data-hv="lift">
      <span class="card-kicker">Ayurvedic</span>
      <h3 class="card-title">Abhyanga</h3>
      <p class="card-body">Traditional ayurvedic massage. Warm herbal oils that support circulation, nourish the skin, calm the nervous system and release muscular tension.</p>
      <p class="card-meta">60 mins — 50€ · book ↗</p>
    </a>
    <a class="card" href="https://wa.me/351938132927?text=Hi!%20I%27m%20interested%20in%20a%20Sports%20massage%20%3A%29" target="_blank" rel="noopener noreferrer" style="text-decoration: none; color: inherit; display: block; cursor: pointer;" data-hv="lift">
      <span class="card-kicker">Recovery</span>
      <h3 class="card-title">Sports massage</h3>
      <p class="card-body">Deep-tissue work to release muscle tension, speed up recovery and support performance.</p>
      <p class="card-meta">60 mins — 50€ · book ↗</p>
    </a>
    <a class="card" href="https://wa.me/351938132927?text=Hi!%20I%27m%20interested%20in%20the%20Ayurvedic%20%26%20Sports%20combination%20%3A%29" target="_blank" rel="noopener noreferrer" style="background: var(--color-accent); border-color: transparent; text-decoration: none; display: block; cursor: pointer;" data-hv="btn">
      <span class="card-kicker" style="color: #EDDFD3;">The shaantha specialty</span>
      <h3 class="card-title" style="color: #FBF6EF;">Ayurvedic &amp; sports</h3>
      <p class="card-body" style="color: color-mix(in srgb, #FBF6EF 88%, transparent);">The best of both worlds — tissue warmed up with ayurvedic oils, combined with deeper muscle work exactly where you need it.</p>
      <p class="card-meta" style="color: #EDDFD3;">60 mins — 50€ · book ↗</p>
    </a>
    <a class="card" href="https://wa.me/351938132927?text=Hi!%20I%27m%20interested%20in%20the%20Head%2C%20neck%20%26%20face%20treatment%20%3A%29" target="_blank" rel="noopener noreferrer" style="text-decoration: none; color: inherit; display: block; cursor: pointer;" data-hv="lift">
      <span class="card-kicker">Release</span>
      <h3 class="card-title">Head, neck &amp; face</h3>
      <p class="card-body">Targeted work where you hold the most tension — with optional herbal steam, face scrub or face mask.</p>
      <p class="card-meta">60 mins — 50€ · book ↗</p>
    </a>
  </div>
</section>

<section id="surf" data-screen-label="Surf recovery" style="max-width: 1200px; margin: 0 auto; padding: clamp(40px, 7vh, 80px) clamp(20px, 5vw, 72px); display: flex; flex-wrap: wrap-reverse; gap: clamp(32px, 5vw, 48px); align-items: center;">
  <div style="flex: 1.4 1 360px; min-width: 0;">
    <span style="display: block; font-size: 15px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-accent-2-800); margin-bottom: 16px;">For surfers</span>
