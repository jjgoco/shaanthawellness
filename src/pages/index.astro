  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-top: 32px;">
    <div class="washed" style="border-radius: 24px; overflow: hidden; aspect-ratio: 4 / 5;">
      <ResponsiveImage name="gal-1" sizes="(max-width: 720px) calc(100vw - 40px), (max-width: 1000px) 45vw, 248px" alt="Warm oils and herbs, ready for treatment" width="667" height="1000" loading="lazy" decoding="async" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
