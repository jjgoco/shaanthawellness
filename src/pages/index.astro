    <div style="flex: 1 1 340px; min-width: 0;">
      <h2 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(30px, 3.4vw, 44px); margin: 0; margin-left: -0.028em; color: var(--color-text);">Recovery pass</h2>
