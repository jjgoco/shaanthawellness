    </div>
    <div class="washed" style="border-radius: 24px; overflow: hidden; aspect-ratio: 4 / 5;">
      <ResponsiveImage name="gal-4" sizes="(max-width: 720px) calc(100vw - 40px), (max-width: 1000px) 45vw, 248px" alt="Deep tissue massage detail" width="1300" height="867" loading="lazy" decoding="async" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
