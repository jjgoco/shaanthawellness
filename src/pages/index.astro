        <span style="font-size: 20px; text-decoration: line-through; color: color-mix(in srgb, var(--color-text) 90%, transparent);">200€</span>
        <span style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(44px, 4.6vw, 60px); line-height: 1; color: var(--color-text);">150€</span>
      </div>
      <span class="tag" style="background: var(--color-accent); color: #FBF6EF; font-weight: 600;">you save 50€</span>
      <span style="font-size: 15px; color: color-mix(in srgb, var(--color-text) 90%, transparent); border-top: 1px dotted var(--color-accent-2-400); padding-top: 10px; margin-top: 4px;">valid for 3 months · mix any treatments</span>
    </div>
  </div>
</section>

<section data-screen-label="About" style="max-width: 1200px; margin: 0 auto; padding: clamp(56px, 9vh, 104px) clamp(20px, 5vw, 72px); display: flex; flex-wrap: wrap; gap: clamp(32px, 5vw, 80px); align-items: center;">
  <div class="washed" style="flex: 1 1 260px; max-width: 360px; margin-inline: auto; aspect-ratio: 4 / 5; border-radius: 180px 180px 32px 32px; overflow: hidden;">
    <ResponsiveImage name="tabea" sizes="(max-width: 720px) calc(100vw - 40px), 500px" alt="Tabea, preparing warm oil for a treatment" width="829" height="1000" loading="lazy" decoding="async" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
  </div>
  <div style="flex: 1.5 1 360px; min-width: 0;">
    <span style="display: block; font-size: 15px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-accent-2-800); margin-bottom: 16px;">The practice</span>
    <h2 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(30px, 3.6vw, 46px); line-height: 1.12; margin: 0; margin-left: -0.028em;">Where ayurveda meets the Atlantic.</h2>
