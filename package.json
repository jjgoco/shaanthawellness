{
  "name": "shaantha-wellness",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "node scripts/run-astro.mjs dev --host 127.0.0.1",
    "build": "node scripts/run-astro.mjs build",
    "postbuild": "node scripts/finalize-build.mjs",
    "preview": "node scripts/run-astro.mjs preview --host 127.0.0.1",
    "check:build": "node scripts/check-build.mjs",
    "check:release": "node scripts/check-release.mjs",
    "test:release": "node --test scripts/release-policy.test.mjs",
    "test": "npm run build && npm run check:build && npm run test:release"
  },
  "dependencies": { "astro": "7.3.5" }
}
